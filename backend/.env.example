# ===== 站点与认证 =====
BASE_URL=https://<你的站点域名>
# 客户端 Basic 凭据,内容为 base64(client_id:client_secret),需自行获取
OAUTH_BASIC=
CHARGE_BASIC=
# 登录后抓包得到的 bearer token 与 refresh token
ACCESS_TOKEN=
REFRESH_TOKEN=

# ===== 缴费项参数 =====
# 格式为 <id>&<名称>,名称仅用于展示,按自己的电表填写
FEEITEM_ID=
XIAOQU_ID=
LOUDONG_ID=
LOUCENG_ID=
ROOM_ID=
TYPE=IEC
LEVEL=4

# ===== 计价与采集 =====
# 电价, 元/度
PRICE_PER_KWH=0.56
# 采集间隔, 分钟
COLLECT_INTERVAL_MINUTES=60
# token 提前多少秒判定需要刷新(默认 3 天)
TOKEN_REFRESH_AHEAD_SECONDS=259200
# 单次用电量异常阈值(度)
USAGE_ANOMALY_KWH=200

# ===== 数据库 =====
DB_PATH=./data/dianfei.db
